import Exploding.Rigidity.Percolation.TriadicWellConnectedLocality

/-!
# Local graph measurability of good cubes

The good-cube event is measurable with respect to the graph induced by the
concentric threefold enlargement, which has finitely many vertices.
-/

namespace Rigidity.Percolation

open Exploding.LatticeBond MeasureTheory

/-- The sigma algebra generated by the open graph induced on a vertex region. -/
abbrev localGraphSigma {d : ℕ} (U : Set (Vertex d)) : MeasurableSpace (Configuration d) :=
  (⊤ : MeasurableSpace (SimpleGraph {x : Vertex d // x ∈ U})).comap
    (fun ω => (openGraph ω).induce U)

/-- A concentric threefold enlargement has finitely many lattice vertices. -/
theorem TriadicCube.finite_centeredTriple {d : ℕ} (Q : TriadicCube d) :
    Q.centeredTriple.Finite := by
  let B : Finset (Vertex d) := Fintype.piFinset fun i =>
    Finset.Icc (Q.center i - 3 * Q.side) (Q.center i + 3 * Q.side)
  apply B.finite_toSet.subset
  intro x hx
  change x ∈ B
  simp only [B, Fintype.mem_piFinset, Finset.mem_Icc]
  intro i
  have hi := abs_lt.mp (Q.abs_coord_sub_center_lt_of_mem_centeredTriple hx i)
  omega

/-- A good-cube event is measurable with respect to the induced graph on the
concentric threefold enlargement. -/
theorem TriadicCube.measurableSet_goodOfWellConnected_localGraph {d : ℕ}
    (Q : TriadicCube d) (interior : TriadicCube d → Set (Vertex d))
    (hinterior : ∀ R, interior R ⊆ R.vertices) :
    MeasurableSet[localGraphSigma Q.centeredTriple]
      {ω | Q ∈ goodOfWellConnected (wellConnectedFamily interior ω)} := by
  apply MeasurableSpace.measurableSet_comap.mpr
  refine ⟨{G | ∃ ω, Q ∈ goodOfWellConnected (wellConnectedFamily interior ω) ∧
    (openGraph ω).induce Q.centeredTriple = G}, trivial, ?_⟩
  ext ω
  simp only [Set.mem_preimage, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨ω', hω', heq⟩
    apply (Q.mem_goodOfWellConnected_congr interior hinterior ?_).mp hω'
    intro x hx y hy
    have hxy := congrArg (fun G : SimpleGraph {x : Vertex d // x ∈ Q.centeredTriple} =>
      G.Adj ⟨x, hx⟩ ⟨y, hy⟩) heq
    exact Iff.of_eq hxy
  · intro hω
    exact ⟨ω, hω, rfl⟩

end Rigidity.Percolation
