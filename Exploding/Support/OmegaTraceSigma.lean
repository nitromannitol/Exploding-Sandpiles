/-
The coordinate σ-field on the state space `Ω = {η | InOmega d ηmin η}` of Section 5 of the
corrected source `paper/corrected-arxiv/exploding-corrected-arxiv.tex` (`\section{A generalization}`,
lines 1233-1248), and its identification with the trace of the product σ-field on `Site d → ℤ`.

The source endows `Ω` with the σ-field generated by the coordinate maps `η ↦ η x`, `x ∈ ℤ^d`.
`omegaCoordMeasurableSpace` is that σ-field, the supremum of the comaps of the coordinate
evaluations on the subtype `{η // InOmega d ηmin η}`. It equals the subtype σ-field
`Subtype.instMeasurableSpace`, the trace of the product σ-field. The measurable events of `Ω`
are exactly the preimages `Subtype.val ⁻¹' A` of the ambient measurable sets `A ⊆ Ω`. The
translations `(T_y η)(z) = η (y + z)` of the source act on `Ω`, and their images and preimages
are compatible with the ambient translations on the traces. The invariant measurable events
of `Ω` correspond to the invariant measurable subsets of `Ω` of the ambient σ-field.
-/
import Exploding.Support.Hypotheses

namespace Exploding

open LatticeProb MeasureTheory

/-- The state space `Ω = {η | InOmega d ηmin η}` as a set of ambient backgrounds. -/
def omegaSet (d : ℕ) (ηmin : ℤ) : Set (Site d → ℤ) := {η | InOmega d ηmin η}

theorem mem_omegaSet {d : ℕ} {ηmin : ℤ} {η : Site d → ℤ} :
    η ∈ omegaSet d ηmin ↔ InOmega d ηmin η := Iff.rfl

/-! ### The coordinate σ-field and its trace -/

/-- The coordinate σ-field on `Ω`: the supremum over `x ∈ ℤ^d` of the comaps of the evaluations
`η ↦ η x` on the subtype `{η // InOmega d ηmin η}`, with `ℤ` carrying its own σ-field. It is the
σ-field generated by the coordinate maps. -/
abbrev omegaCoordMeasurableSpace (d : ℕ) (ηmin : ℤ) :
    MeasurableSpace {η : Site d → ℤ // InOmega d ηmin η} :=
  ⨆ x : Site d, MeasurableSpace.comap
    (fun η : {η : Site d → ℤ // InOmega d ηmin η} => η.1 x) (inferInstance : MeasurableSpace ℤ)

/-- Each coordinate `η ↦ η x` is measurable for the coordinate σ-field. -/
theorem measurable_omegaCoord (d : ℕ) (ηmin : ℤ) (x : Site d) :
    @Measurable _ ℤ (omegaCoordMeasurableSpace d ηmin) _
      (fun η : {η : Site d → ℤ // InOmega d ηmin η} => η.1 x) :=
  measurable_iff_comap_le.mpr (le_iSup (fun y : Site d => MeasurableSpace.comap
    (fun η : {η : Site d → ℤ // InOmega d ηmin η} => η.1 y)
    (inferInstance : MeasurableSpace ℤ)) x)

/-- The coordinate σ-field is the least σ-field making every coordinate measurable. -/
theorem omegaCoordMeasurableSpace_le (d : ℕ) (ηmin : ℤ)
    {m : MeasurableSpace {η : Site d → ℤ // InOmega d ηmin η}}
    (h : ∀ x : Site d, @Measurable _ ℤ m _
      (fun η : {η : Site d → ℤ // InOmega d ηmin η} => η.1 x)) :
    omegaCoordMeasurableSpace d ηmin ≤ m :=
  iSup_le fun x => measurable_iff_comap_le.mp (h x)

/-- **The coordinate σ-field equals the trace of the product σ-field.** The σ-field generated by
the coordinates on `Ω` is exactly the subtype σ-field `Subtype.instMeasurableSpace` of
`Site d → ℤ` restricted to `Ω`. -/
theorem omegaCoordMeasurableSpace_eq_subtype (d : ℕ) (ηmin : ℤ) :
    omegaCoordMeasurableSpace d ηmin = Subtype.instMeasurableSpace := by
  refine le_antisymm (omegaCoordMeasurableSpace_le d ηmin fun x => ?_) ?_
  · exact (measurable_pi_apply x).comp measurable_subtype_coe
  · show MeasurableSpace.comap Subtype.val
        (⨆ x : Site d, MeasurableSpace.comap (fun f : Site d → ℤ => f x)
          (inferInstance : MeasurableSpace ℤ)) ≤ omegaCoordMeasurableSpace d ηmin
    rw [MeasurableSpace.comap_iSup]
    refine iSup_le fun x => ?_
    rw [MeasurableSpace.comap_comp]
    exact le_iSup (fun y : Site d => MeasurableSpace.comap
      (fun η : {η : Site d → ℤ // InOmega d ηmin η} => η.1 y)
      (inferInstance : MeasurableSpace ℤ)) x

/-! ### Measurable events of `Ω` and ambient traces -/

/-- `Ω` is a measurable subset of `Site d → ℤ`: a countable intersection of coordinate
cylinders. -/
theorem measurableSet_omegaSet (d : ℕ) (ηmin : ℤ) : MeasurableSet (omegaSet d ηmin) := by
  have hZ : ∀ s : Set ℤ, MeasurableSet s := fun s => MeasurableSpace.measurableSet_top
  have hset : omegaSet d ηmin = ⋂ x : Site d, (fun η : Site d → ℤ => η x) ⁻¹'
      {n : ℤ | ηmin ≤ n ∧ n ≤ 2 * (d : ℤ) - 1} := by
    ext η
    simp only [omegaSet, InOmega, Set.mem_setOf_eq, Set.mem_iInter, Set.mem_preimage]
  rw [hset]
  exact MeasurableSet.iInter fun x => measurable_pi_apply x (hZ _)

/-- The coordinate-measurable events of `Ω` are the subtype-measurable events. -/
theorem measurableSet_omegaCoord_iff (d : ℕ) (ηmin : ℤ)
    (E : Set {η : Site d → ℤ // InOmega d ηmin η}) :
    MeasurableSet[omegaCoordMeasurableSpace d ηmin] E ↔ MeasurableSet E := by
  rw [omegaCoordMeasurableSpace_eq_subtype]

/-- **Measurable events of `Ω` are exactly the preimages of ambient measurable subsets of `Ω`.**
An event `E ⊆ Ω` is measurable iff `E = Subtype.val ⁻¹' A` for some ambient measurable `A ⊆ Ω`;
then `A = Subtype.val '' E`. -/
theorem measurableSet_omegaSub_iff (d : ℕ) (ηmin : ℤ)
    (E : Set {η : Site d → ℤ // InOmega d ηmin η}) :
    MeasurableSet E ↔ ∃ A : Set (Site d → ℤ), MeasurableSet A ∧ A ⊆ omegaSet d ηmin ∧
      E = Subtype.val ⁻¹' A := by
  constructor
  · intro hE
    refine ⟨Subtype.val '' E, ?_, ?_, (Subtype.val_injective.preimage_image E).symm⟩
    · have hΩ := measurableSet_omegaSet d ηmin
      exact MeasurableSet.subtype_image hΩ hE
    · rintro _ ⟨η, -, rfl⟩
      exact η.2
  · rintro ⟨A, hA, -, rfl⟩
    exact hA.preimage measurable_subtype_coe

/-- For an ambient set `A ⊆ Ω`, its preimage in `Ω` has `A` as its trace. -/
theorem omegaSub_image_preimage {d : ℕ} {ηmin : ℤ} {A : Set (Site d → ℤ)}
    (hA : A ⊆ omegaSet d ηmin) :
    Subtype.val '' (Subtype.val ⁻¹' A : Set {η : Site d → ℤ // InOmega d ηmin η}) = A := by
  ext η
  constructor
  · rintro ⟨ξ, hξ, rfl⟩
    exact hξ
  · intro hη
    exact ⟨⟨η, hA hη⟩, hη, rfl⟩

/-! ### Translations on `Ω` -/

/-- The translation `(T_y η)(z) = η (y + z)` of the source, acting on `Ω`. -/
def omegaSubShift (d : ℕ) (ηmin : ℤ) (y : Site d)
    (η : {η : Site d → ℤ // InOmega d ηmin η}) : {η : Site d → ℤ // InOmega d ηmin η} :=
  ⟨fun z => η.1 (y + z), fun x => η.2 (y + x)⟩

/-- The underlying background of a translate is the ambient translation. -/
theorem omegaSubShift_val (d : ℕ) (ηmin : ℤ) (y : Site d)
    (η : {η : Site d → ℤ // InOmega d ηmin η}) :
    (omegaSubShift d ηmin y η).1 = fun z => η.1 (y + z) := rfl

/-- Translation by `0` is the identity. -/
theorem omegaSubShift_zero (d : ℕ) (ηmin : ℤ) (η : {η : Site d → ℤ // InOmega d ηmin η}) :
    omegaSubShift d ηmin 0 η = η := by
  apply Subtype.ext
  funext z
  show η.1 (0 + z) = η.1 z
  rw [zero_add]

/-- Translating by `-y` undoes translation by `y`. -/
theorem omegaSubShift_neg_shift (d : ℕ) (ηmin : ℤ) (y : Site d)
    (η : {η : Site d → ℤ // InOmega d ηmin η}) :
    omegaSubShift d ηmin (-y) (omegaSubShift d ηmin y η) = η := by
  apply Subtype.ext
  funext z
  show η.1 (y + (-y + z)) = η.1 z
  have hz : y + (-y + z) = z := by abel
  rw [hz]

/-- Translating by `y` undoes translation by `-y`. -/
theorem omegaSubShift_shift_neg (d : ℕ) (ηmin : ℤ) (y : Site d)
    (η : {η : Site d → ℤ // InOmega d ηmin η}) :
    omegaSubShift d ηmin y (omegaSubShift d ηmin (-y) η) = η := by
  apply Subtype.ext
  funext z
  show η.1 (-y + (y + z)) = η.1 z
  have hz : -y + (y + z) = z := by abel
  rw [hz]

/-- Each translation is measurable on the subtype σ-field of `Ω`. -/
theorem measurable_omegaSubShift (d : ℕ) (ηmin : ℤ) (y : Site d) :
    Measurable (omegaSubShift d ηmin y) := by
  intro s hs
  obtain ⟨u, hu, rfl⟩ := hs
  have hshift : Measurable
      (fun η : {η : Site d → ℤ // InOmega d ηmin η} => fun z => η.1 (y + z)) :=
    measurable_pi_lambda _ fun z => (measurable_pi_apply (y + z)).comp measurable_subtype_coe
  exact hshift hu

/-- The image of an event under a translation is the preimage under the inverse translation. -/
theorem omegaSubShift_image_eq_preimage (d : ℕ) (ηmin : ℤ) (y : Site d)
    (E : Set {η : Site d → ℤ // InOmega d ηmin η}) :
    omegaSubShift d ηmin y '' E = omegaSubShift d ηmin (-y) ⁻¹' E := by
  ext ξ
  constructor
  · rintro ⟨η, hη, rfl⟩
    show omegaSubShift d ηmin (-y) (omegaSubShift d ηmin y η) ∈ E
    rw [omegaSubShift_neg_shift]
    exact hη
  · intro hξ
    exact ⟨omegaSubShift d ηmin (-y) ξ, hξ, omegaSubShift_shift_neg d ηmin y ξ⟩

/-- Translation maps measurable events of `Ω` to measurable events of `Ω`. -/
theorem measurableSet_omegaSubShift_image (d : ℕ) (ηmin : ℤ) (y : Site d)
    {E : Set {η : Site d → ℤ // InOmega d ηmin η}} (hE : MeasurableSet E) :
    MeasurableSet (omegaSubShift d ηmin y '' E) := by
  rw [omegaSubShift_image_eq_preimage]
  exact measurable_omegaSubShift d ηmin (-y) hE

/-- On traces, the subtype translation is the ambient translation `(z ↦ η (y + z))`. -/
theorem val_image_omegaSubShift_image (d : ℕ) (ηmin : ℤ) (y : Site d)
    (E : Set {η : Site d → ℤ // InOmega d ηmin η}) :
    Subtype.val '' (omegaSubShift d ηmin y '' E) =
      (fun η : Site d → ℤ => fun z => η (y + z)) '' (Subtype.val '' E) := by
  simp only [Set.image_image]
  rfl

/-! ### Invariance of events -/

/-- An event `E ⊆ Ω` is invariant under the source translations `T_y`, `y ∈ L`, exactly when its
trace `Subtype.val '' E` is invariant under the ambient translations. -/
theorem omegaSub_invariant_iff (d : ℕ) (ηmin : ℤ) (L : AddSubgroup (Site d))
    (E : Set {η : Site d → ℤ // InOmega d ηmin η}) :
    E = ⋂ y ∈ (L : Set (Site d)), omegaSubShift d ηmin y '' E ↔
      Subtype.val '' E = ⋂ y ∈ (L : Set (Site d)),
        (fun η : Site d → ℤ => fun z => η (y + z)) '' (Subtype.val '' E) := by
  constructor
  · intro hE
    ext a
    constructor
    · rintro ⟨ξ, hξ, rfl⟩
      rw [Set.mem_iInter₂]
      intro y hy
      have hξ' : ξ ∈ ⋂ y ∈ (L : Set (Site d)), omegaSubShift d ηmin y '' E := by
        rw [← hE]
        exact hξ
      obtain ⟨ζ, hζ, hζξ⟩ := Set.mem_iInter₂.mp hξ' y hy
      exact ⟨ζ.1, ⟨ζ, hζ, rfl⟩, congrArg Subtype.val hζξ⟩
    · intro ha
      obtain ⟨b, hb, hba⟩ := Set.mem_iInter₂.mp ha 0 L.zero_mem
      have hb0 : b = a := by
        rw [← hba]
        funext z
        simp
      rw [← hb0]
      exact hb
  · intro hA
    have hinv : ∀ y ∈ (L : Set (Site d)), ∀ b ∈ Subtype.val '' E,
        (fun η : Site d → ℤ => fun z => η (y + z)) b ∈ Subtype.val '' E := by
      intro y hy b hb
      have hb2 : b ∈ ⋂ y ∈ (L : Set (Site d)),
          (fun η : Site d → ℤ => fun z => η (y + z)) '' (Subtype.val '' E) := by
        rw [← hA]
        exact hb
      obtain ⟨c, hc, hcb⟩ := Set.mem_iInter₂.mp hb2 (-y) (L.neg_mem hy)
      rw [← hcb]
      convert hc using 1
      funext z
      simp
    ext ξ
    constructor
    · intro hξ
      rw [Set.mem_iInter₂]
      intro y hy
      obtain ⟨ζ, hζ, hζv⟩ := hinv (-y) (L.neg_mem hy) ξ.1 ⟨ξ, hξ, rfl⟩
      have hζeq : ζ = omegaSubShift d ηmin (-y) ξ := Subtype.ext hζv
      refine ⟨ζ, hζ, ?_⟩
      rw [hζeq]
      exact omegaSubShift_shift_neg d ηmin y ξ
    · intro hξ
      obtain ⟨ζ, hζ, hζξ⟩ := Set.mem_iInter₂.mp hξ 0 L.zero_mem
      rw [omegaSubShift_zero] at hζξ
      rw [← hζξ]
      exact hζ

/-- **The source's coordinate-measurable invariant events of `Ω` are exactly the preimages of
ambient measurable invariant subsets `A ⊆ Ω`.** Thus the source ergodicity on `(Ω, F)` concerns the
same events as the ambient measurable events `A ⊆ Ω` with `A = ⋂_{y∈L} τ_y A`. -/
theorem omegaCoord_invariant_iff_exists (d : ℕ) (ηmin : ℤ) (L : AddSubgroup (Site d))
    (E : Set {η : Site d → ℤ // InOmega d ηmin η}) :
    (MeasurableSet[omegaCoordMeasurableSpace d ηmin] E ∧
        E = ⋂ y ∈ (L : Set (Site d)), omegaSubShift d ηmin y '' E) ↔
      ∃ A : Set (Site d → ℤ), MeasurableSet A ∧ A ⊆ omegaSet d ηmin ∧
        E = Subtype.val ⁻¹' A ∧
        A = ⋂ y ∈ (L : Set (Site d)), (fun η : Site d → ℤ => fun z => η (y + z)) '' A := by
  rw [measurableSet_omegaCoord_iff]
  constructor
  · rintro ⟨hE, hinv⟩
    obtain ⟨A, hA, hAΩ, hEA⟩ := (measurableSet_omegaSub_iff d ηmin E).mp hE
    have himg : Subtype.val '' E = A := by
      rw [hEA, omegaSub_image_preimage hAΩ]
    refine ⟨A, hA, hAΩ, hEA, ?_⟩
    rw [← himg]
    exact (omegaSub_invariant_iff d ηmin L E).mp hinv
  · rintro ⟨A, hA, hAΩ, hEA, hAinv⟩
    subst hEA
    refine ⟨hA.preimage measurable_subtype_coe, ?_⟩
    refine (omegaSub_invariant_iff d ηmin L _).mpr ?_
    rw [omegaSub_image_preimage hAΩ]
    exact hAinv

end Exploding
